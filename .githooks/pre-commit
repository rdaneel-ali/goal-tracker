#!/usr/bin/env bash
# Blocks commits that contain secrets. Fails closed if gitleaks is missing.
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed. Install it, then retry." >&2
  echo "See https://github.com/gitleaks/gitleaks#installing" >&2
  exit 1
fi

gitleaks git --pre-commit --staged --redact --verbose
